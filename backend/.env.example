# Copy to .env on the server and fill in real values (never commit .env)

# Postgres connection string
DATABASE_URL=postgres://jeen:CHANGE_ME@localhost:5432/jeen_event

# Port the Express API listens on (nginx reverse-proxies /api to this)
PORT=3001

# Secret used to sign the session cookie — use a long random string
SESSION_SECRET=CHANGE_ME_to_a_long_random_string

# Shared admin password for the /admin area (single shared login, per spec §8)
ADMIN_PASSWORD=CHANGE_ME

# Set to "production" on the server so the session cookie is marked Secure
NODE_ENV=production

# Whether the admin session cookie is marked Secure (HTTPS-only). Leave unset to
# default to on in production. Set to false ONLY while serving over plain HTTP,
# then switch back to true once TLS is in front of the app.
# COOKIE_SECURE=false

# Public origin of the RSVP site. Used as the "register / change your mind"
# link in the maybe & declined emails. Defaults to https://rsvp.jeenai.app.
PUBLIC_BASE_URL=https://rsvp.jeenai.app

# ---------------------------------------------------------------------------
# Outbound email — automatic registration / approval / decline emails.
# If nothing below is configured, emails are simply disabled (the app keeps
# working). Two modes are supported; the app auto-detects which one to use.
#
# MODE A — Microsoft 365 with OAuth2 / XOAUTH2 (modern auth, app-only).
#   Passes the "Block legacy authentication" Conditional Access policy that
#   blocks basic SMTP AUTH. Set the three MS_* values (from an Entra App
#   Registration with the Office 365 Exchange Online → SMTP.SendAsApp
#   application permission, admin-consented), plus the sender mailbox. Do NOT
#   set SMTP_PASS in this mode.
#     SMTP_HOST=smtp.office365.com
#     SMTP_PORT=587
#     SMTP_USER=nimbus5@jeen.ai        # the sending mailbox
#     MS_TENANT_ID=<Directory (tenant) ID>
#     MS_CLIENT_ID=<Application (client) ID>
#     MS_CLIENT_SECRET=<client secret value>
#     MAIL_FROM=Jeen.ai כנס <nimbus5@jeen.ai>
#
# MODE B — Basic SMTP AUTH (SendGrid / SES / Gmail / any host).
#   SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey (literal),
#     SMTP_PASS=<API key>, MAIL_FROM=a verified sender/domain.
#
# Fill in ONE mode. Uncomment/complete the block you use.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# SMTP_SECURE=true   # set true only for port 465 (implicit TLS)
SMTP_USER=nimbus5@jeen.ai
# Basic-auth password (MODE B only; leave empty for OAuth MODE A):
SMTP_PASS=
# OAuth2 app-only credentials (MODE A only):
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# From header shown to recipients:
MAIL_FROM=Jeen.ai כנס <nimbus5@jeen.ai>

# Recipients of the daily status digest (scripts/daily-digest.js, run via cron).
# Comma-separated. Defaults to the organizing team.
DIGEST_RECIPIENTS=meital@jeen.ai, matan@jeen.ai, inbar@jeen.ai, eran@jeen.ai

# ---------------------------------------------------------------------------
# Event details used in the emails (optional — sensible defaults are built in;
# override here if the date/place/title change without a code deploy).
# EVENT_TITLE=ככה עושים AI בממשלה
# EVENT_SUBTITLE=מהבטחה ליישום בסקייל
# EVENT_DATE_LABEL=יום שלישי, 20.10.2026 · 09:00–13:00
# EVENT_PLACE=משרדי Jeen.ai · בגין 121, מגדלי עזריאלי שרונה, קומה 34, תל אביב
# EVENT_START_UTC=20261020T060000Z
# EVENT_END_UTC=20261020T100000Z
