# Copy to .env on the server and fill in real values (never commit .env)

# Postgres connection string
DATABASE_URL=postgres://jeen:CHANGE_ME@localhost:5432/jeen_event

# Port the Express API listens on (nginx reverse-proxies /api to this)
PORT=3001

# Secret used to sign the session cookie — use a long random string
SESSION_SECRET=CHANGE_ME_to_a_long_random_string

# Shared admin password for the /admin area (single shared login, per spec §8)
ADMIN_PASSWORD=CHANGE_ME

# Set to "production" on the server so the session cookie is marked Secure
NODE_ENV=production

# Whether the admin session cookie is marked Secure (HTTPS-only). Leave unset to
# default to on in production. Set to false ONLY while serving over plain HTTP,
# then switch back to true once TLS is in front of the app.
# COOKIE_SECURE=false

# Public origin of the site, used for the add-to-calendar link (optional)
PUBLIC_BASE_URL=https://event.jeen.ai

# ---------------------------------------------------------------------------
# Outbound email (SMTP) — automatic registration / approval / decline emails.
# If these are left blank, emails are simply disabled (the app keeps working).
# For Google Workspace (jeen.ai): host smtp.gmail.com, port 587, user a mailbox
# address, pass a 16-char App Password (Google account → Security → App passwords).
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # set true only for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
# From header shown to recipients:
MAIL_FROM=Jeen.ai כנס <events@jeen.ai>

# ---------------------------------------------------------------------------
# Event details used in the emails (optional — sensible defaults are built in;
# override here if the date/place/title change without a code deploy).
# EVENT_TITLE=מצפן הבינה למגזר הציבורי:
# EVENT_SUBTITLE=מהבטחה ליישום בסקייל
# EVENT_DATE_LABEL=יום שלישי, 20.10.2026 · 09:00–13:00
# EVENT_PLACE=משרדי Jeen.ai · בגין 121, מגדלי עזריאלי שרונה, קומה 34, תל אביב
# EVENT_START_UTC=20261020T060000Z
# EVENT_END_UTC=20261020T100000Z
